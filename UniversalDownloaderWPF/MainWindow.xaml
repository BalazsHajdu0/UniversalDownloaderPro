<Window x:Class="UniversalDownloaderWPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Universal Downloader Pro v4.5" 
        Height="850" Width="1050"
        MinHeight="650" MinWidth="850"
        Background="{StaticResource BackgroundDarkBrush}"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI">

    <!-- IDE KERÜLTEK A MODERN DIZÁJN ELEMEK -->
    <Window.Resources>
        <!-- Színpaletta -->
        <SolidColorBrush x:Key="BackgroundDarkBrush" Color="#0F0F15"/>
        <SolidColorBrush x:Key="BackgroundMediumBrush" Color="#1A1A24"/>
        <SolidColorBrush x:Key="AccentBlueBrush" Color="#3B82F6"/>
        <SolidColorBrush x:Key="AccentGreenBrush" Color="#10B981"/>
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F3F4F6"/>
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#9CA3AF"/>

        <!-- Modern Szövegdoboz (TextBox) -->
        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="#252530"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="#383845"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="CaretBrush" Value="{StaticResource AccentBlueBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern Legördülő (ComboBox) -->
        <Style x:Key="ModernComboBox" TargetType="ComboBox">
            <Setter Property="Background" Value="#252530"/>
            <Setter Property="Foreground" Value="Black"/>
            <!-- A belső elemek miatt -->
            <Setter Property="BorderBrush" Value="#383845"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>

        <!-- Fő (Primary) Gomb -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource AccentBlueBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Opacity" Value="0.85"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Opacity" Value="0.6"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Alsó menü (Modern) Gombok -->
        <Style x:Key="ModernButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Opacity" Value="0.8"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Másodlagos (Secondary) Gomb -->
        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource ModernButton}">
            <Setter Property="Background" Value="#2A2A35"/>
        </Style>

        <!-- Fülek (TabControl és TabItem) modernizálása -->
        <Style TargetType="TabControl">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Border" Padding="20,12" Background="Transparent" CornerRadius="10,10,0,0" Margin="0,0,5,0">
                            <ContentPresenter x:Name="ContentSite" VerticalAlignment="Center" HorizontalAlignment="Center" ContentSource="Header"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="{StaticResource BackgroundMediumBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="False">
                                <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#252530"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- CheckBox modernizálása -->
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
    </Window.Resources>

    <!-- INNENTŐL AZ EREDETI KÓDOD, CSAK A STÍLUSOKRA TÁMASZKODVA -->
    <Grid Margin="25">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Border Grid.Row="0" Background="#111118" CornerRadius="15" Padding="25,20" Margin="0,0,0,20">
            <Border.Effect>
                <DropShadowEffect BlurRadius="15" ShadowDepth="5" Opacity="0.3" Color="Black"/>
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" HorizontalAlignment="Center">
                    <TextBlock Text="UNIVERSAL DOWNLOADER" 
                       FontSize="36" FontWeight="Black" 
                       Foreground="White" 
                       HorizontalAlignment="Center"/>   
                    <TextBlock Text="Professional Edition v4.5" 
                               FontSize="14" FontWeight="SemiBold"
                               Foreground="{StaticResource AccentBlueBrush}" 
                               HorizontalAlignment="Center"
                               Margin="0,5,0,0"/>
                </StackPanel>

                <TextBlock x:Name="StatusText" Grid.Row="1" 
                           Text="⏳ Ready to download" 
                           FontSize="13" 
                           Foreground="{StaticResource TextSecondaryBrush}"
                           HorizontalAlignment="Center"
                           Margin="0,15,0,0"/>
            </Grid>
        </Border>

        <!-- MAIN CONTENT - TABS -->
        <TabControl Grid.Row="1" Margin="0,0,0,20">

            <!-- DOWNLOAD TAB -->
            <TabItem Header="📥  Download">
                <Border Background="{StaticResource BackgroundMediumBrush}" CornerRadius="0,15,15,15" Padding="25">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="15" ShadowDepth="5" Opacity="0.2" Color="Black"/>
                    </Border.Effect>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Label -->
                        <TextBlock Grid.Row="0" 
                                   Text="🎵  Enter URLs or search terms (one per line)" 
                                   FontSize="15" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   Margin="0,0,0,10"/>

                        <!-- Input TextBox -->
                        <TextBox x:Name="BatchInput" Grid.Row="1"
                                 Style="{StaticResource ModernTextBox}"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 Text=""
                                 Margin="0,0,0,20">
                            <TextBox.ToolTip>
                                <ToolTip>
                                    <TextBlock>
                                        Examples:&#x0a;
                                        Ava Max - Salt&#x0a;
                                        https://youtube.com/watch?v=...
                                    </TextBlock>
                                </ToolTip>
                            </TextBox.ToolTip>
                        </TextBox>

                        <!-- Quick Settings -->
                        <Grid Grid.Row="2" Margin="0,0,0,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="40"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="Format:" 
                                       VerticalAlignment="Center" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       FontSize="14" Margin="0,0,10,0"/>
                            <ComboBox x:Name="FormatComboBox" Grid.Column="1" 
                                      Style="{StaticResource ModernComboBox}"
                                      SelectedIndex="0">
                                <ComboBoxItem Content="mp3"/>
                                <ComboBoxItem Content="wav"/>
                                <ComboBoxItem Content="ogg"/>
                                <ComboBoxItem Content="m4a"/>
                                <ComboBoxItem Content="mp4"/>
                            </ComboBox>

                            <TextBlock Grid.Column="3" Text="Quality:" 
                                       VerticalAlignment="Center" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       FontSize="14" Margin="0,0,10,0"/>
                            <ComboBox x:Name="QualityComboBox" Grid.Column="4" 
                                      Style="{StaticResource ModernComboBox}"
                                      SelectedIndex="1">
                                <ComboBoxItem Content="128"/>
                                <ComboBoxItem Content="192"/>
                                <ComboBoxItem Content="256"/>
                                <ComboBoxItem Content="320"/>
                            </ComboBox>
                        </Grid>

                        <!-- Action Buttons -->
                        <Grid Grid.Row="3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Button Grid.Column="0" Content="🚀  START DOWNLOAD" 
                                    Style="{StaticResource PrimaryButton}"
                                    FontSize="18"
                                    Height="65"
                                    Click="StartDownload_Click"/>

                            <Button Grid.Column="2" 
                                    Style="{StaticResource SecondaryButton}"
                                    Height="65"
                                    Click="DownloadPlaylist_Click">
                                <StackPanel>
                                    <TextBlock Text="📋  FULL PLAYLIST" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Download entire channel/playlist" FontSize="12" HorizontalAlignment="Center" Opacity="0.6" Margin="0,3,0,0"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Grid>
                </Border>
            </TabItem>

            <!-- QUEUE TAB -->
            <TabItem Header="📋  Queue">
                <Border Background="{StaticResource BackgroundMediumBrush}" CornerRadius="0,15,15,15" Padding="25">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Stats -->
                        <TextBlock x:Name="StatsText" Grid.Row="0"
                                   Text="Active: 0  |  Completed: 0  |  Failed: 0"
                                   FontSize="16" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,20"/>

                        <!-- Task List -->
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="TaskList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#252530" CornerRadius="12" 
                                                Margin="0,0,0,10" Padding="15">
                                            <Border.BorderBrush>
                                                <SolidColorBrush Color="#3B82F6" Opacity="0.5"/>
                                            </Border.BorderBrush>
                                            <Border.BorderThickness>1</Border.BorderThickness>

                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>

                                                <!-- Header -->
                                                <Grid Grid.Row="0" Margin="0,0,0,10">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <TextBlock Text="{Binding DisplayName}" 
                                                               FontSize="15" FontWeight="Bold"
                                                               Foreground="White"
                                                               TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Grid.Column="1" 
                                                               Text="{Binding StatusText}" 
                                                               FontSize="13" FontWeight="Bold"
                                                               Foreground="{Binding StatusColor}"/>
                                                </Grid>

                                                <!-- Progress Bar -->
                                                <ProgressBar Grid.Row="1" 
                                                             Value="{Binding Progress}" 
                                                             Maximum="100"
                                                             Height="8"
                                                             Foreground="{StaticResource AccentBlueBrush}"
                                                             Background="#1A1A24"
                                                             BorderThickness="0"
                                                             Margin="0,0,0,10">
                                                    <ProgressBar.Resources>
                                                        <Style TargetType="Border">
                                                            <Setter Property="CornerRadius" Value="4"/>
                                                        </Style>
                                                    </ProgressBar.Resources>
                                                </ProgressBar>

                                                <!-- Info -->
                                                <Grid Grid.Row="2">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>

                                                    <TextBlock Text="{Binding SpeedText}" 
                                                               FontSize="12" FontWeight="SemiBold"
                                                               Foreground="{StaticResource TextSecondaryBrush}"/>
                                                    <TextBlock Grid.Column="1" 
                                                               Text="{Binding EtaText}" 
                                                               FontSize="12" FontWeight="SemiBold"
                                                               Foreground="{StaticResource TextSecondaryBrush}"
                                                               HorizontalAlignment="Center"/>
                                                    <TextBlock Grid.Column="2" 
                                                               Text="{Binding ProgressText}" 
                                                               FontSize="13" FontWeight="Bold"
                                                               Foreground="{StaticResource AccentBlueBrush}"
                                                               HorizontalAlignment="Right"/>
                                                </Grid>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </TabItem>

            <!-- SETTINGS TAB -->
            <TabItem Header="⚙️  Settings">
                <Border Background="{StaticResource BackgroundMediumBrush}" CornerRadius="0,15,15,15" Padding="35">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="📁  Download Folder" 
                                       FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"
                                       Margin="0,0,0,10"/>
                            <TextBox x:Name="FolderTextBox" 
                                     Style="{StaticResource ModernTextBox}"
                                     Text="Downloads"
                                     Margin="0,0,0,25"/>

                            <TextBlock Text="⚡  Parallel Downloads" 
                                       FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"
                                       Margin="0,0,0,10"/>
                            <ComboBox x:Name="ParallelComboBox" 
                                      Style="{StaticResource ModernComboBox}"
                                      Width="250" HorizontalAlignment="Left"
                                      SelectedIndex="1"
                                      Margin="0,0,0,25">
                                <ComboBoxItem Content="1"/>
                                <ComboBoxItem Content="2"/>
                                <ComboBoxItem Content="3"/>
                                <ComboBoxItem Content="4"/>
                                <ComboBoxItem Content="5"/>
                            </ComboBox>

                            <TextBlock Text="🔄  Retry Attempts" 
                                       FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"
                                       Margin="0,0,0,10"/>
                            <ComboBox x:Name="RetryComboBox" 
                                      Style="{StaticResource ModernComboBox}"
                                      Width="250" HorizontalAlignment="Left"
                                      SelectedIndex="2"
                                      Margin="0,0,0,35">
                                <ComboBoxItem Content="1"/>
                                <ComboBoxItem Content="2"/>
                                <ComboBoxItem Content="3"/>
                                <ComboBoxItem Content="5"/>
                            </ComboBox>

                            <Border Height="1" Background="#383845" Margin="0,0,0,30"/>

                            <TextBlock Text="⚙️  Advanced Options" 
                                       FontSize="18" FontWeight="Bold"
                                       Foreground="{StaticResource AccentBlueBrush}"
                                       Margin="0,0,0,20"/>

                            <CheckBox x:Name="NumberingCheckBox" 
                                      Content="🔢  Track Numbering (track1, track2, ...)"
                                      Margin="0,0,0,15"/>
                            <CheckBox x:Name="MetadataCheckBox" 
                                      Content="🏷️  ID3 Metadata (artist, title tags)"
                                      Margin="0,0,0,15"/>
                            <CheckBox x:Name="ThumbnailCheckBox" 
                                      Content="🖼️  Album Cover (embed thumbnail)"
                                      Margin="0,0,0,40"/>

                            <Button Content="💾  SAVE SETTINGS" 
                                    Style="{StaticResource PrimaryButton}"
                                    Background="{StaticResource AccentGreenBrush}"
                                    FontSize="16"
                                    Height="55"
                                    Width="250"
                                    HorizontalAlignment="Left"
                                    Click="SaveSettings_Click"/>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </TabItem>
        </TabControl>

        <!-- FOOTER -->
        <Grid Grid.Row="2" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" Content="🗑️  Clear Queue" 
                    Style="{StaticResource ModernButton}"
                    Background="#B91C1C" Height="45"
                    Margin="0,0,8,0"
                    Click="ClearQueue_Click"/>
            <Button Grid.Column="1" Content="📂  Open Folder" 
                    Style="{StaticResource ModernButton}"
                    Background="#374151" Height="45"
                    Margin="4,0"
                    Click="OpenFolder_Click"/>
            <Button Grid.Column="2" Content="📄  Open Log" 
                    Style="{StaticResource ModernButton}"
                    Background="#374151" Height="45"
                    Margin="4,0"
                    Click="OpenLog_Click"/>
            <Button Grid.Column="3" Content="❌  Exit" 
                    Style="{StaticResource ModernButton}"
                    Background="#7F1D1D" Height="45"
                    Margin="8,0,0,0"
                    Click="Exit_Click"/>
        </Grid>
    </Grid>
</Window>